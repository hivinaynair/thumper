# Single local env file for the whole monorepo: cp .env.example .env
# Loaded by bun when you run root scripts; turbo forwards the vars listed in
# turbo.json `globalEnv` to each package task. Also used by docker compose for
# ${...} substitution. Run dev/build from the repo root, not inside apps/*.

# Clerk (invite-only / allowlist in dashboard)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
CLERK_SECRET_KEY=

# Postgres (local: localhost — not the docker hostname "postgres")
DATABASE_URL=postgres://thumper:thumper@localhost:5432/thumper

# Cookie encryption (min 32 chars)
COOKIE_ENCRYPTION_KEY=change-me-to-a-long-random-secret-key!!

# Local disk for cookies + media, shared by web and worker.
# Must be absolute: the two apps run with different cwds. Omit when using Blob.
DATA_DIR=/absolute/path/to/thumper/data

# Worker
WORKER_CONCURRENCY=1
YT_DLP_PATH=/opt/homebrew/bin/yt-dlp

# Hybrid (Vercel + Modal) — leave unset for local/Compose disk storage
# BLOB_READ_WRITE_TOKEN=
# PROCESS_BACKEND=modal
# MODAL_JOB_URL=
# MODAL_SEARCH_URL=   # retag SoundCloud search; defaults to MODAL_JOB_URL with /wake → /search
# MODAL_WEBHOOK_SECRET=
