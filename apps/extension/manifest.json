{
  "manifest_version": 3,
  "name": "Thumper Cookie Sync",
  "version": "0.3.0",
  "description": "Refresh YouTube and SoundCloud cookies onto your private Thumper instance.",
  "permissions": ["cookies", "storage", "tabs"],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://*.google.com/*",
    "https://*.soundcloud.com/*",
    "https://thumper.vinaynair.dev/*",
    "http://localhost:3004/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Thumper",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://thumper.vinaynair.dev/*", "http://localhost:3004/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
