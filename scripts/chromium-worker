#!/usr/bin/env python3
"""Drop from the root worker to uid/gid 922, then exec system Chromium.

Do not use util-linux privilege helpers that mutate the capability bounding
set: Docker/Modal seccomp reject that with "Operation not permitted".
"""

from __future__ import annotations

import os
import sys
from collections.abc import Sequence
from typing import IO, Any

CHROMIUM = "/usr/bin/chromium"
CHROMIUM_HOME = "/var/lib/chromium"
CHROMIUM_UID = 922
CHROMIUM_GID = 922
ALLOWED_ENV = ("PATH", "HOME", "TMPDIR", "LANG", "XDG_RUNTIME_DIR")
DEFAULT_ENV = {
    "PATH": "/usr/bin:/bin",
    "HOME": CHROMIUM_HOME,
    "TMPDIR": "/var/lib/chromium/tmp",
    "LANG": "C.UTF-8",
    "XDG_RUNTIME_DIR": "/var/lib/chromium/xdg",
}


def run(
    argv: Sequence[str],
    *,
    os_module: Any = os,
    stderr: IO[str] = sys.stderr,
) -> None:
    os_module.umask(0o077)
    if os_module.geteuid() != 0:
        stderr.write(
            "chromium-worker must be launched by the worker root process\n"
        )
        raise SystemExit(126)
    kept = {
        key: os_module.environ[key]
        for key in ALLOWED_ENV
        if os_module.environ.get(key)
    }
    for key, value in DEFAULT_ENV.items():
        kept.setdefault(key, value)
    os_module.environ.clear()
    os_module.environ.update(kept)
    os_module.chdir(CHROMIUM_HOME)
    os_module.setgid(CHROMIUM_GID)
    os_module.setgroups([])
    os_module.setuid(CHROMIUM_UID)
    os_module.execv(CHROMIUM, [CHROMIUM, "--no-sandbox", *argv[1:]])


if __name__ == "__main__":
    run(sys.argv)
